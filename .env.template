# ============================================================================
# MetLife ML Ops Challenge - Variables de entorno
# ----------------------------------------------------------------------------
# Copiar a .env y ajustar:
#   cp .env.template .env
#
# IMPORTANTE segun el entorno:
#   DB_HOST=localhost si PostgreSQL corre en la maquina; el nombre del host
#   o del servicio si corre en otro lado.
# ============================================================================

# ========== DATABASE ==========
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metlife_db
DB_USER=metlife_user
DB_PASSWORD=change_this_in_production_please

# ========== MLFLOW: TRACKING ==========
# Backend store en PostgreSQL. Es obligatorio un backend con base de datos (en
# vez de file://) para poder usar el Model Registry.
#
# Se usa una base SEPARADA de la de negocio: MLflow crea 59 tablas propias y
# mezclarlas con training_dataset / batch_monitoring vuelve ilegible el esquema
# de la aplicacion. Hay que crearla una sola vez:
#     createdb -O metlife_user mlflow_db
MLFLOW_DB_NAME=mlflow_db

# Por defecto el URI se deriva de las credenciales DB_* de arriba, para no
# duplicar la password. Descomentar solo para apuntar a otro backend, por
# ejemplo un tracking server remoto o sqlite en un entorno sin Postgres:
# MLFLOW_TRACKING_URI=postgresql+psycopg2://usuario:password@host:5432/mlflow_db
# MLFLOW_TRACKING_URI=http://mlflow-server:5000

# Donde se guardan los artefactos (modelo, reportes, baseline_stats.json, ...)
MLFLOW_ARTIFACT_ROOT=./mlruns

# Un unico experimento para entrenamiento y scoring: sus runs loguean el mismo
# conjunto canonico de metricas, asi que son comparables y se pueden graficar
# como una sola serie. Los runs se distinguen por el tag `pipeline_stage`:
#   training            el modelo ganador de la comparacion entre familias
#   training_candidate  cada familia evaluada en esa comparacion
#   training_trial      cada combinacion de la busqueda de hiperparametros
#   scoring             scoring (padre y por lote, ver el tag `scope`)
MLFLOW_EXPERIMENT=insurance-charges

# Descomentar solo para volver a separarlos:
# MLFLOW_EXPERIMENT_TRAINING=insurance-charges-training
# MLFLOW_EXPERIMENT_SCORING=insurance-charges-scoring

# ========== MLFLOW: MODEL REGISTRY ==========
# El nombre designa la TAREA, no el algoritmo: el entrenamiento compara varias
# familias y la ganadora puede no ser XGBoost. La familia de cada version queda en
# su tag `model_family`. Para seguir usando el registry viejo: insurance-charges-xgb
MLFLOW_MODEL_NAME=insurance-charges-regressor

# No registrar una version nueva si sus metricas y su familia son identicas a las de
# la ultima. Evita que reentrenar con la misma semilla (verificando, por ejemplo) llene
# el Registry de versiones indistinguibles. false = registrar siempre.
REGISTER_SKIP_DUPLICATES=true

# Criterio de "mejor modelo": que metrica se optimiza y en que direccion.
MODEL_SELECTION_METRIC=val_rmse
MODEL_SELECTION_MODE=min

# Gates de promocion a produccion (usados por src/promote_model.py)
PROMOTION_MIN_R2=0.75
PROMOTION_MAX_OVERFITTING=0.15
PROMOTION_MIN_IMPROVEMENT=0.0

# ========== TRAINING ==========
LOG_LEVEL=INFO

# Presupuesto de busqueda POR FAMILIA, no un total a repartir: cada familia corre
# round(HYPERPARAM_ITERATIONS x su n_iter_ratio) iteraciones, topeadas por el tamano
# de su grid (ver src/model_zoo.py). Con el catalogo por defecto, 50 aca son
# 50+20+20+20 = 110 iteraciones en total. Bajarlo recorta las cuatro a la vez.
HYPERPARAM_ITERATIONS=50
CV_FOLDS=5

# Que familias se comparan. El orden de esta lista no importa: se entrenan y se
# desempatan en el orden del catalogo de src/model_zoo.py (gana el incumbente).
# Disponibles: xgboost, random_forest, hist_gradient_boosting, elasticnet
# Dejar solo xgboost reproduce el pipeline previo a la comparacion.
TRAIN_MODEL_FAMILIES=xgboost,random_forest,hist_gradient_boosting,elasticnet

# Combinaciones de la busqueda que se loguean como runs anidados, POR FAMILIA.
# El cv_results_*.csv de cada familia guarda la busqueda completa igual.
TRIALS_TOP_N=5
RANDOM_SEED=42
SPLIT_SEED=43
TEST_SIZE=0.2

# ========== SCORING ==========
# prod   -> puntua los lotes de data/prod/ (modo por defecto del challenge)
# sample -> comportamiento legacy: N filas aleatorias de training_dataset
SCORING_MODE=prod
PROD_DATA_DIR=data/prod
SCORING_SAMPLE_SIZE=10

# Si es true, el pipeline termina con exit code != 0 cuando algun batch da ALERT.
# Default false: el monitoreo reporta, no rompe el pipeline.
FAIL_ON_ALERT=false

# ========== UMBRALES DE MONITOREO ==========
# PSI (Population Stability Index) por feature
PSI_WARN=0.10
PSI_ALERT=0.25

# Degradacion de performance: RMSE_batch / RMSE_validacion
PERF_WARN_RATIO=1.25
PERF_ALERT_RATIO=1.50

# Caida absoluta de R2 respecto a validacion
R2_WARN_DROP=0.05
R2_ALERT_DROP=0.15

# Ratio media(target_batch) / media(target_baseline)
TARGET_SHIFT_WARN=0.25
TARGET_SHIFT_ALERT=1.00

# % de filas que violan el contrato de datos (rango / categoria)
SCHEMA_WARN_PCT=0.0
SCHEMA_ALERT_PCT=1.0

# ========== BUILD INFO (opcional) ==========
VERSION=2.0.0
