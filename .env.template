# ============================================================================
# MetLife ML Ops Challenge - Variables de entorno
# ----------------------------------------------------------------------------
# Copiar a .env y ajustar:
#   cp .env.template .env
#
# IMPORTANTE segun el entorno:
#   - Docker  -> DB_HOST=postgres   (nombre del servicio en docker-compose)
#   - Local   -> DB_HOST=localhost
# ============================================================================

# ========== DATABASE ==========
DB_HOST=postgres
DB_PORT=5432
DB_NAME=metlife_db
DB_USER=metlife_user
DB_PASSWORD=change_this_in_production_please

# ========== MLFLOW: TRACKING ==========
# Backend store. SQLite es obligatorio (en vez de file://) para poder usar el
# Model Registry, que requiere un backend con base de datos.
MLFLOW_TRACKING_URI=sqlite:///mlflow/mlflow.db

# Donde se guardan los artefactos (modelo, reportes, baseline_stats.json, ...)
MLFLOW_ARTIFACT_ROOT=./mlruns

# Nombres de los experimentos
MLFLOW_EXPERIMENT_TRAINING=insurance-charges-training
MLFLOW_EXPERIMENT_SCORING=insurance-charges-scoring

# ========== MLFLOW: MODEL REGISTRY ==========
MLFLOW_MODEL_NAME=insurance-charges-xgb

# Criterio de "mejor modelo": que metrica se optimiza y en que direccion.
MODEL_SELECTION_METRIC=val_rmse
MODEL_SELECTION_MODE=min

# Gates de promocion a produccion (usados por src/promote_model.py)
PROMOTION_MIN_R2=0.75
PROMOTION_MAX_OVERFITTING=0.15
PROMOTION_MIN_IMPROVEMENT=0.0

# ========== TRAINING ==========
LOG_LEVEL=INFO
HYPERPARAM_ITERATIONS=50
CV_FOLDS=5
RANDOM_SEED=42
SPLIT_SEED=43
TEST_SIZE=0.2

# ========== SCORING ==========
# prod   -> puntua los lotes de data/prod/ (modo por defecto del challenge)
# sample -> comportamiento legacy: N filas aleatorias de training_dataset
SCORING_MODE=prod
PROD_DATA_DIR=data/prod
SCORING_SAMPLE_SIZE=10

# Si es true, el pipeline termina con exit code != 0 cuando algun batch da ALERT.
# Default false: el monitoreo reporta, no rompe el pipeline.
FAIL_ON_ALERT=false

# ========== UMBRALES DE MONITOREO ==========
# PSI (Population Stability Index) por feature
PSI_WARN=0.10
PSI_ALERT=0.25

# Degradacion de performance: RMSE_batch / RMSE_validacion
PERF_WARN_RATIO=1.25
PERF_ALERT_RATIO=1.50

# Caida absoluta de R2 respecto a validacion
R2_WARN_DROP=0.05
R2_ALERT_DROP=0.15

# Ratio media(target_batch) / media(target_baseline)
TARGET_SHIFT_WARN=0.25
TARGET_SHIFT_ALERT=1.00

# % de filas que violan el contrato de datos (rango / categoria)
SCHEMA_WARN_PCT=0.0
SCHEMA_ALERT_PCT=1.0

# ========== BUILD INFO (opcional) ==========
VERSION=2.0.0
